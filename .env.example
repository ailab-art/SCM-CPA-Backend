# Copy this to .env for local dev. On Railway, set these as project
# variables instead (Settings → Variables) — never commit a real .env.

PORT=8080

# Same Supabase project the Next.js frontend uses. This MUST be the
# service-role key, not the anon key — it's what lets this backend write
# credits/resumes/payments despite RLS, and profiles.sql's
# protect_privileged_columns trigger only lets the service role touch
# is_admin / is_master_admin / credits_*.
SUPABASE_URL=https://xgjdtbcfqvqlswtdrnda.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# openrouter.ai — sign up, create a key. The model below is a genuinely free
# (":free"-suffixed) OpenRouter model as of when this was written; OpenRouter
# adds/retires free models over time, so check https://openrouter.ai/models
# and filter by "Free" if this one stops working, then update this one
# variable — no code change needed.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Razorpay dashboard → Settings → API Keys (use test keys until you're ready
# to take real payments). The webhook secret is set separately under
# Settings → Webhooks when you add this backend's /api/webhooks/razorpay URL.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Your deployed frontend origin — used for CORS and as OpenRouter's required
# HTTP-Referer header. Comma-separate if you need more than one (e.g. also
# http://localhost:3000 while developing).
FRONTEND_URL=https://scm-cloudboo-cpa.vercel.app,http://localhost:3000
